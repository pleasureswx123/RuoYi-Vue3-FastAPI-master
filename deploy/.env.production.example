# Compose 与对外端口
COMPOSE_PROJECT_NAME=ruoyi-shot-grid-prod
APP_RELEASE_ID=local
BIND_ADDRESS=0.0.0.0
ADMIN_PORT=12580
SHOT_GRID_PORT=12581
BACKEND_APP_UID=100
BACKEND_APP_GID=101

# PostgreSQL / Redis，仅在独立 Compose 网络内访问
POSTGRES_USER=ruoyi_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=ruoyi_fastapi
REDIS_USERNAME=
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DATABASE=2

# FastAPI 生产参数
APP_ENV=production
APP_NAME='Shot Grid API'
APP_ROOT_PATH=/prod-api
APP_HOST=0.0.0.0
APP_PORT=9099
APP_VERSION=1.0.0
APP_RELOAD=false
APP_WORKERS=2
APP_IP_LOCATION_QUERY=false
APP_DEMO_MODE=false
APP_SAME_TIME_LOGIN=true
APP_DISABLE_SWAGGER=true
APP_DISABLE_REDOC=true
APP_TRUSTED_PROXY_IPS=*
APP_TRUSTED_PROXY_HOPS=1
APP_CORS_ALLOWED_ORIGINS=CHANGE_ME_CORS_ORIGINS
APP_DEFAULT_ENABLED_PLUGINS=

# 认证与数据库连接池
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REDIS_EXPIRE_MINUTES=30
DB_TYPE=postgresql
DB_ECHO=false
DB_MAX_OVERFLOW=10
DB_POOL_SIZE=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# 生产日志只写 stdout，由 Docker local 驱动轮转
LOG_MASK_ENABLED=true
LOG_STREAM_MAXLEN=20000
LOGURU_JSON=true
LOGURU_LEVEL=INFO
LOGURU_STDOUT=true
LOG_FILE_ENABLED=false
LOG_INSTANCE_ID=prod
LOG_SERVICE_NAME=ruoyi-fastapi-backend
LOG_WORKER_ID=auto

# 传输加密：首次初始化脚本会生成全新的 RSA 密钥对
# 当前公司内网固定使用 HTTP；浏览器不会在普通内网 HTTP 地址开放 Web Crypto API。
# 如果未来切换 HTTPS，应同时恢复为 true / required，并重新执行真实加密登录验收。
TRANSPORT_CRYPTO_ENABLED=false
TRANSPORT_CRYPTO_MODE=off
TRANSPORT_CRYPTO_ALGORITHM=RSA_OAEP_AES_256_GCM
TRANSPORT_CRYPTO_KID=CHANGE_ME_CRYPTO_KID
TRANSPORT_CRYPTO_RSA_KEY_SIZE=3072
TRANSPORT_CRYPTO_PUBLIC_KEY='CHANGE_ME_CRYPTO_PUBLIC_KEY'
TRANSPORT_CRYPTO_PRIVATE_KEY='CHANGE_ME_CRYPTO_PRIVATE_KEY'
TRANSPORT_CRYPTO_LEGACY_KEY_PAIRS=[]
TRANSPORT_CRYPTO_PUBLIC_KEY_TTL_SECONDS=3600
TRANSPORT_CRYPTO_FRONTEND_CONFIG_TTL_SECONDS=300
TRANSPORT_CRYPTO_CLOCK_SKEW_SECONDS=120
TRANSPORT_CRYPTO_REPLAY_TTL_SECONDS=300

# Linux 生产节点通过显式 UNC→CIFS 映射访问 NAS；未完成真实挂载验收前必须保持两个 Worker 关闭
SHOT_GRID_NAS_HOST_MOUNT=/mnt/ruoyi-shot-grid/shotgrid-main/ShotGridProd
SHOT_GRID_NAS_CONTAINER_MOUNT=/mnt/ruoyi-shot-grid/shotgrid-main
SHOT_GRID_NAS_UNC_MOUNT_MAP={}
SHOT_GRID_NAS_REQUIRE_CIFS_MOUNT=true
SHOT_GRID_STORAGE_WORKER_ENABLED=false
SHOT_GRID_VERSION_WORKER_ENABLED=false
SHOT_GRID_MEDIA_WORKER_ENABLED=true
SHOT_GRID_MEDIA_WORKER_FFMPEG_PATH=ffmpeg
SHOT_GRID_MEDIA_WORKER_BATCH_SIZE=2

# 生产运行期间禁止自动安装插件依赖
PLUGIN_DEPENDENCY_POLICY_MODE=prod=plan_only
PLUGIN_DEPENDENCY_ALLOW_PROD_INSTALL=false
PLUGIN_DEPENDENCY_REQUIRE_YES=true
