{
  "$schema": "./node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Shot Grid",
  "version": "0.1.2",
  "identifier": "cn.laputta.shotgrid",
  "build": {
    "beforeBuildCommand": "npm.cmd run build:desktop-ui",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [],
    "security": { "capabilities": [] }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "gen/native/ShotGridNas.exe": "tools/ShotGridNas.exe" },
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "languages": ["SimpChinese"], "installMode": "currentUser" } }
  }
}
