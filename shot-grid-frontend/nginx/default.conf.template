server {
    listen 80;
    server_name _;

    client_max_body_size 100m;

    location = /healthz {
        access_log off;
        return 200 'ok';
    }

    location = / {
        return 302 /shot-grid-app/;
    }

    location = /shot-grid-app {
        return 308 /shot-grid-app/;
    }

    location /shot-grid-app/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /shot-grid-app/index.html;
    }

    location = /prod-api {
        return 308 /prod-api/;
    }

    location = /prod-api/realtime/ws {
        proxy_pass ${BACKEND_UPSTREAM}/realtime/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
    }

    location /prod-api/ {
        proxy_pass ${BACKEND_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /prod-api;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /50x.html {
        root /usr/share/nginx/html;
    }

    error_page 500 502 503 504 /50x.html;
}
