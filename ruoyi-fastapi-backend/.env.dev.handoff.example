# Copy to .env.dev; replace placeholders before starting. Never commit secrets.
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=9099
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DB_DATABASE=ruoyi-fastapi
DB_ECHO=false
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DATABASE=2
REDIS_PASSWORD=
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
TRANSPORT_CRYPTO_ENABLED=true
TRANSPORT_CRYPTO_MODE=required
TRANSPORT_CRYPTO_KID=dev-handoff
TRANSPORT_CRYPTO_PUBLIC_KEY='CHANGE_ME_PUBLIC_KEY'
TRANSPORT_CRYPTO_PRIVATE_KEY='CHANGE_ME_PRIVATE_KEY'
SHOT_GRID_STORAGE_WORKER_ENABLED=false
SHOT_GRID_VERSION_WORKER_ENABLED=false
SHOT_GRID_MEDIA_WORKER_ENABLED=false
