FROM python:3.11.15-slim-bookworm

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
ARG APP_UID=100
ARG APP_GID=101

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Shanghai

WORKDIR /app

RUN sed -ri \
        "s#http://deb.debian.org/debian-security#${DEBIAN_SECURITY_MIRROR}#g; s#http://deb.debian.org/debian#${DEBIAN_MIRROR}#g" \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential ffmpeg gosu libpq-dev tzdata \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo Asia/Shanghai > /etc/timezone \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system --gid "${APP_GID}" app \
    && adduser --system --uid "${APP_UID}" --ingroup app --home /app app

COPY requirements-pg.lock.txt ./
ARG PIP_INSTALL_INDEX_URL=${PIP_INDEX_URL}
# 锁文件末尾的本项目安装移到源码复制后，CLI 改动不重装第三方依赖。
RUN --mount=type=cache,target=/root/.cache/pip \
    sed 's/\r$//; /^\.$/d' requirements-pg.lock.txt > /tmp/requirements-deps.txt \
    && python -m pip install --index-url "${PIP_INSTALL_INDEX_URL}" -r /tmp/requirements-deps.txt

COPY . .
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-deps --no-build-isolation .
COPY docker/entrypoint.prod.sh /usr/local/bin/ruoyi-entrypoint

# 兼容服务器严格 umask，应用身份只获源码读取和目录遍历权限。
RUN sed -i 's/\r$//' /usr/local/bin/ruoyi-entrypoint \
    && chmod 0755 /usr/local/bin/ruoyi-entrypoint \
    && mkdir -p /app/logs /app/caches /app/vf_admin \
    && chgrp -R app /app \
    && chmod -R g+rX /app \
    && chown app:app /app/logs /app/caches /app/vf_admin

ENV HOME=/app

EXPOSE 9099

ENTRYPOINT ["/usr/local/bin/ruoyi-entrypoint"]
CMD ["ruoyi", "app", "run", "--env=production"]
